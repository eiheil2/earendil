{
	"name": "@earendil-works/pi-web-host",
	"version": "1.0.0",
	"description": "Local HTTP host for Pi browser profiles",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsc -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"pi",
		"web",
		"server"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/web-host"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-server": "1.0.0"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}
