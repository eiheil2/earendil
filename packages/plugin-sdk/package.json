{
	"name": "@earendil-works/pi-plugin-sdk",
	"version": "1.0.0",
	"description": "Versioned contract surface for pi extensions: manifest envelope, capabilities, and API version",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./api": {
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js"
		},
		"./capabilities": {
			"types": "./dist/capabilities.d.ts",
			"import": "./dist/capabilities.js"
		},
		"./compat": {
			"types": "./dist/compat.d.ts",
			"import": "./dist/compat.js"
		},
		"./events": {
			"types": "./dist/events.d.ts",
			"import": "./dist/events.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"import": "./dist/manifest.js"
		},
		"./version": {
			"types": "./dist/version.d.ts",
			"import": "./dist/version.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"pi",
		"extensions",
		"plugin",
		"contract",
		"sdk"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/plugin-sdk"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"semver": "7.8.5",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}